# 复制到受保护的 EnvironmentFile，权限 0600；不要提交真实值
IOT_PG_DSN=postgres://user:password@host:5432/odoo20iot
IOT_NATS_URL=nats://host:4222
IOT_REDIS_URL=redis://host:6379/0
ODOO_API_KEY=replace-at-deploy-time
ODOO_WEBHOOK_TOKEN=replace-at-deploy-time
IOT_DLQ_ALERT_WEBHOOK=replace-at-deploy-time
IOT_DLQ_ALERT_EGRESS_ALLOW=open.feishu.cn

# odoo-connector；真实环境请写入 /home/xfusion/etc/odoo20iot.env
ODOO_URL=http://100.64.0.3:9070
ODOO_DB=odoo20
ODOO_CONNECTOR_HTTP_ADDR=127.0.0.1:18091
ODOO_ALARM_TO_ODOO=true
ODOO_RECONCILE_MODELS=maintenance.equipment,maintenance.request
ODOO_MASTERDATA_MODEL=maintenance.equipment
